# Local development env template.
# Copy this file to .env.local and fill in real values.
#
# Where to get each key:
#   ANTHROPIC_API_KEY            console.anthropic.com → Settings → API Keys
#   QSTASH_TOKEN                 app.upstash.com → QStash → API Keys → QSTASH_TOKEN
#   QSTASH_CURRENT_SIGNING_KEY   app.upstash.com → QStash → API Keys → Current Signing Key
#   QSTASH_NEXT_SIGNING_KEY      app.upstash.com → QStash → API Keys → Next Signing Key
#   UPSTASH_REDIS_REST_URL       app.upstash.com → Redis → REST API → URL
#   UPSTASH_REDIS_REST_TOKEN     app.upstash.com → Redis → REST API → Token
#   BLOB_READ_WRITE_TOKEN        Vercel dashboard → Storage → Blob → Create Token (or grab from deployed project)

ANTHROPIC_API_KEY=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
